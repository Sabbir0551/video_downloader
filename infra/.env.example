# PostgreSQL Credentials
POSTGRES_USER=anystream_user
POSTGRES_PASSWORD=replace_with_strong_password_minimum_16_chars
POSTGRES_DB=anystream_db

# Cryptographic Keys (production must be >= 32 characters)
SECRET_KEY=production_secret_key_minimum_32_characters_long_entropy
IP_HASH_SALT=rotating_production_ip_salt_minimum_16_chars
ADMIN_API_KEY=admin_review_secret_key_change_in_production

