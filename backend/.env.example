# AnyStream Environment Configuration
PROJECT_NAME="AnyStream Video Platform"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Security (Change in production!)
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key
IP_HASH_SALT=replace-with-a-random-salt-for-ip-hashing

# PostgreSQL Database (Host / Credentials)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anystream
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/anystream

# Redis Queue & Cache
REDIS_URL=redis://localhost:6379/0

# Storage Backend ("local" or "r2")
STORAGE_BACKEND=local
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=anystream-files
